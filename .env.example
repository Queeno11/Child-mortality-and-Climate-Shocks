# Environment variables for the Child Mortality & Climate Shocks project.
#
# Copy this file to `.env` and fill in the paths for your machine:
#     cp .env.example .env
#
# Only EXTERNAL datasets (kept outside the project folder because of their size)
# need to be configured here. Project-internal folders (Data/Data_in,
# Data/Data_proc, Data/Data_out, Outputs) are derived automatically from the
# project location in paths.py and need no configuration.
#
# `.env` is git-ignored — do NOT commit it. Paths may contain spaces; wrap them
# in quotes as shown below.

# Directory with the monthly ERA5 single-level reanalysis (00_query_ERA5_data.py,
# 01_compute_climate_indices.py). Holds the yearly data_<year>.zip / .nc files.
ERA5_MONTHLY_DIR="/mnt/e/Datasets/ERA5 Reanalysis/monthly-single-levels"

# Directory with the daily ERA5 single-level reanalysis (00b_query_ERA5_dialy.py).
ERA5_DAILY_DIR="/mnt/d/Datasets/ERA5 Reanalysis/dialy-single-levels"

# Köppen-Geiger climate-classification grid file used to assign climatic bands
# (02b_assign_climatic_bands.py).
CLIMATE_BANDS="/mnt/e/Datasets/Köppen-Geiger Climate Classification/KG_1986-2010.grd"

# Country income-group / metadata lookup workbook (03_merge_climate_and_DHS.py).
COUNTRY_CLASSIFICATION="/mnt/e/World Bank/Data-Portal-Brief-Generator/Data/Data_Raw/Country codes & metadata/country_classification.xlsx"
